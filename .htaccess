# =====================================================
# Thrift Store - Apache Configuration
# =====================================================

# Enable rewrite engine
RewriteEngine On

# Backward compatibility redirects for old URLs
RewriteRule ^login\.php$ auth/login.php [R=301,L]
RewriteRule ^register\.php$ auth/register.php [R=301,L]
RewriteRule ^logout\.php$ auth/logout.php [R=301,L]
RewriteRule ^forgot-password\.php$ auth/forgot-password.php [R=301,L]
RewriteRule ^reset-password\.php$ auth/reset-password.php [R=301,L]
RewriteRule ^products\.php$ shop/products.php [R=301,L,QSA]
RewriteRule ^product-detail\.php$ shop/product-detail.php [R=301,L,QSA]
RewriteRule ^cart\.php$ shop/cart.php [R=301,L]
RewriteRule ^checkout\.php$ shop/checkout.php [R=301,L]
RewriteRule ^wishlist\.php$ shop/wishlist.php [R=301,L]
RewriteRule ^wishlist-add\.php$ shop/wishlist-add.php [R=301,L,QSA]
RewriteRule ^profile\.php$ user/profile.php [R=301,L]
RewriteRule ^orders\.php$ user/orders.php [R=301,L]
RewriteRule ^order-confirmation\.php$ user/order-confirmation.php [R=301,L,QSA]

# Protect sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect config and includes
<FilesMatch "^(config|includes)/">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to database files
<FilesMatch "\.(sql|sqlite|db)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to log files
<FilesMatch "\.(log|txt)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Disable directory browsing
Options -Indexes

# Prevent access to .htaccess
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Set default charset
AddDefaultCharset UTF-8

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Set cache headers for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# PHP settings (if using mod_php)
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
    php_value error_log logs/php_errors.log
    php_value upload_max_filesize 5M
    php_value post_max_size 5M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
